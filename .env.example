# WebGuardian AI Environment Configuration

# Service settings
HOST=127.0.0.1
PORT=8000

# Database Configuration
# SQLite is default for simple local setup. Switch to postgresql:// for production.
DATABASE_URL=sqlite:///./webguardian.db

# LLM Configuration
# Options: mock, openai, gemini, groq
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini

# API Keys (Keep blank or generic when LLM_PROVIDER=mock)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Bright Data API Settings
# By default, WebGuardian runs in Demo Mode using MockBrightDataService.
# Provide credentials here to connect to Scraper Studio in production.
BRIGHT_DATA_API_KEY=your_bright_data_api_key_here
BRIGHT_DATA_CUSTOMER_ID=your_customer_id_here
